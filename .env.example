# ---------- Content sources ----------
# Semicolon-separated repositories to watch.
CONTENTAUTOPILOT_GITHUB_REPOS=RanchoTao/ContentAutopilot
# Optional; raises GitHub API rate limits and enables private-repo collection.
CONTENTAUTOPILOT_GITHUB_TOKEN=
CONTENTAUTOPILOT_LOOKBACK_HOURS=72

# ---------- LLM ----------
# Works with OpenAI-compatible Chat Completions endpoints.
CONTENTAUTOPILOT_LLM_API_KEY=
CONTENTAUTOPILOT_LLM_BASE_URL=https://api.openai.com/v1
CONTENTAUTOPILOT_LLM_MODEL=gpt-5-mini
CONTENTAUTOPILOT_MIN_PUBLISH_SCORE=0.68

# ---------- Storage ----------
CONTENTAUTOPILOT_DATA_DIR=data

# ---------- X user-context credentials ----------
CONTENTAUTOPILOT_X_CONSUMER_KEY=
CONTENTAUTOPILOT_X_CONSUMER_SECRET=
CONTENTAUTOPILOT_X_ACCESS_TOKEN=
CONTENTAUTOPILOT_X_ACCESS_TOKEN_SECRET=

# Even an approved draft cannot be posted live unless this is true.
CONTENTAUTOPILOT_ALLOW_LIVE_PUBLISH=false
